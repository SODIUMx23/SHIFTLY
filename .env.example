# Shiftly — config template. Safe to commit; contains no real values.
# Copy to `.env` and fill in from:
#   Firebase console -> Project settings (gear) -> General -> Your apps -> Config

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Optional: restrict sign-in to campus domains, comma-separated, no @.
# e.g. ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in,vit.ac.in
ALLOWED_EMAIL_DOMAINS=

PORT=8081
