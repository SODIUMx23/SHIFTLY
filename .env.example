# Shiftly — config template (safe to commit, contains no secrets).
#
#   cp .env.example .env      <- then fill in FIREBASE_API_KEY
#
# The three values below are already filled in for the project `shiftly-tws`.
# They are NOT secrets — Firebase ships them to every browser by design, which
# is why they can live in a public repo. Replace them if you switch projects.
# Full setup notes: SETUP-GOOGLE-LOGIN.md

FIREBASE_PROJECT_ID=shiftly-tws
FIREBASE_AUTH_DOMAIN=shiftly-tws.firebaseapp.com
FIREBASE_APP_ID=1:90722673490:web:78e359d9f3240aaae50b0d0

# ---- THE ONLY VALUE YOU HAVE TO FIND YOURSELF -------------------------------
# Firebase console -> Project settings (gear) -> General -> Your apps -> Config
# Click the COPY icon on the apiKey line (do not drag-select — it is 39 chars
# and easy to clip). It must be 39 characters and start with "AIza".
# Then run: python check_config.py
FIREBASE_API_KEY=

# Optional: restrict sign-in to campus emails, comma-separated, no @.
# e.g. ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in,vit.ac.in
ALLOWED_EMAIL_DOMAINS=

PORT=8081

# --- Login sessions (required for the API to stay secure across restarts) ---
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is made at boot — secure, but every restart logs everyone out.
SESSION_SECRET=
SESSION_HOURS=24

# --- Real UPI payments via Razorpay (optional but recommended) ----------------
# Dashboard: https://dashboard.razorpay.com/app/keys  (test keys are free,
# generated instantly, no KYC — perfect for demos. Swap to live keys after KYC.)
# Leave BOTH empty to keep the wallet in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Database location -------------------------------------------------------
# Default: shiftly.db next to the code. On Render, add a persistent disk and
# point this at it so accounts & money survive deploys: /var/data/shiftly.db
DB_PATH=

# --- SMS ---------------------------------------------------------------------
# Mobile OTP currently returns a demo code on-screen (free, no SMS provider).
# Going live needs an Indian SMS provider (MSG91/Twilio) with DLT registration —
# the single remaining genuinely-paid feature. Plug the call into sendOtp in
# main.py where marked; everything else is provider-agnostic already.
